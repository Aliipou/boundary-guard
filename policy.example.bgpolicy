# boundary-guard policy (DSL). One philosophy, many isolated repositories.

layer philosophy       = philosophy, theory
layer authgate         = authgate
layer fdk              = fdk
layer banking          = banking, ledger
layer robotics         = robot, robotics, authrobo
layer quantum_research = quantum, qkd, qfl
layer observability    = observability, analytics

# allowed dependency direction — one-way DAG, everything points down toward authgate
allow fdk      -> authgate
allow banking  -> authgate
allow robotics -> authgate
allow banking  -> fdk
allow robotics -> fdk
allow observability -> *          # the observer may read anything

# hard-forbidden edges (always errors)
forbid robotics -> quantum_research : no quantum on a real-time, safety-critical control path
forbid banking  -> quantum_research : the money path is deterministic and replayable; quantum cannot enter it
forbid fdk      -> quantum_research : the autonomy gate is deterministic; quantum stays in the research sandbox
forbid authgate -> quantum_research : production core stays classical + PQC; quantum is T3 research only
forbid authgate -> banking          : the capability kernel holds no financial state
forbid *        -> observability    : nothing depends on the observer (dependency is one-way)
forbid philosophy -> *              : the theory layer imports no implementation
